<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_soft">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEARBY SUPPORT" android:textColor="@color/brand" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Help around you" android:textColor="@color/ink" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hospitals, clinics, pharmacies, and police near your current location — only when you ask." android:textColor="@color/muted" android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="@color/brand_mint" app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location only when you ask" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/nearbyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your coordinates are not stored by this demo screen." android:textColor="@color/muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refreshNearbyButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Refresh nearby places" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Demo results" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@android:color/white" android:padding="18dp" android:text="Police Station\nPolice · 6.2 km away\n\nDirections available after provider integration" android:textColor="@color/ink" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@android:color/white" android:padding="18dp" android:text="General Hospital\nHospital · 6.8 km away\n\n24-hour emergency department" android:textColor="@color/ink" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@android:color/white" android:padding="18dp" android:text="24-Hour Pharmacy\nPharmacy · 7.0 km away\n\nOpen late" android:textColor="@color/ink" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@android:color/white" android:padding="18dp" android:text="Urgent Care\nClinic · 7.5 km away\n\nWalk-in care" android:textColor="@color/ink" android:textSize="16sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Demo data is intentionally labeled. Verify real-world listings before relying on them." android:textColor="@color/muted" android:textSize="12sp" />
  </LinearLayout>
</ScrollView>