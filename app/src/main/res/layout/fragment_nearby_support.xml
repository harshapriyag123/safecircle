<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_soft">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEARBY SUPPORT" android:textColor="@color/brand" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Help around you" android:textColor="@color/ink" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hospitals, clinics, pharmacies, and police near your current location — only when you ask." android:textColor="@color/muted" android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="@color/brand_mint" app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location only when you ask" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/nearbyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Choose a category to search using your maps app. SafeCircle does not store coordinates here." android:textColor="@color/muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refreshNearbyButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Find hospitals in maps" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/nearbyPolice" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Find police in maps" />
    <com.google.android.material.button.MaterialButton android:id="@+id/nearbyPharmacy" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Find pharmacies in maps" />
    <com.google.android.material.button.MaterialButton android:id="@+id/nearbyClinic" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Find urgent care in maps" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Maps uses its own location permissions and privacy policy. Verify opening hours and services before relying on a listing. This does not contact emergency services." android:textColor="@color/muted" />
  </LinearLayout>
</ScrollView>