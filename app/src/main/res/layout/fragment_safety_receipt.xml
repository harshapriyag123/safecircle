<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_soft">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIVACY RECEIPT" android:textColor="@color/brand" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="What was shared — and when it stops." android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Every Safety Session can produce a human-readable receipt so temporary sharing is auditable instead of invisible." android:textColor="@color/muted" android:textSize="15sp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="26dp" app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LATEST SESSION" android:textColor="@color/brand" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/receiptSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Loading receipt…" android:textColor="@color/ink" android:textSize="16sp" android:lineSpacingExtra="6dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/brand_mint" app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Receipt guarantees" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="✓ Session-scoped sharing\n✓ Guardian role recorded\n✓ Privacy mode recorded\n✓ Sharing end state visible\n✓ No claim of permanent location access" android:textColor="@color/ink" android:textSize="15sp" android:lineSpacingExtra="5dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</ScrollView>