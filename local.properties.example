# Copy this file to local.properties (do not commit the real file)
sdk.dir=/path/to/Android/Sdk

# RevenueCat public Android SDK key
REVENUECAT_API_KEY=test_your_public_sdk_key_here

# Optional SafeCircle hackathon backend.
# Do not ship a shared demo token in production; replace with real per-user auth.
SAFECIRCLE_API_BASE_URL=http://10.0.2.2:8080
SAFECIRCLE_DEMO_API_TOKEN=replace-with-local-demo-api-token
